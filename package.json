{
  "name": "kane-beam",
  "version": "0.1.1",
  "description": "Kane checks the screen. Your app confirms it. An MCP server and CLI that weighs every Kane CLI verdict against your app's own truth, so a coding agent can catch and fix false greens.",
  "type": "module",
  "bin": {
    "kane-beam": "bin/kane-beam.mjs"
  },
  "files": [
    "bin/",
    "skill/",
    "probe/",
    "beam.json",
    "src/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "suite": "node src/cli.mjs suite",
    "add-issue": "node src/cli.mjs add-issue",
    "kane:install": "node src/cli.mjs kane-install",
    "site": "node src/cli.mjs site",
    "lab": "node src/cli.mjs lab"
  },
  "license": "MIT",
  "repository": "github:CryptoZephyr/beam",
  "keywords": [
    "kane-cli",
    "testing",
    "ai-agents",
    "claude-code",
    "e2e",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "mcpName": "io.github.kane-beam/beam",
  "homepage": "https://kane-beam.vercel.app"
}
